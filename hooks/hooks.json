{
  "description": "oh-my-tbd PreToolUse veto check — the discipline backstop. Per D-014, D-034, D-043, D-047, D-048.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/tbd.js", "hook", "veto-check"]
          }
        ]
      }
    ]
  }
}
